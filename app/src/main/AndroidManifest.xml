<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:ignore="ExactAlarm" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" tools:ignore="FullScreenIntent" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".WaktivaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Waktiva"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Waktiva">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.adhan.AdhanActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Waktiva"
            tools:targetApi="27" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".receiver.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ybugmobile.waktiva.ACTION_PRAYER_ALARM" />
                <action android:name="com.ybugmobile.waktiva.ACTION_PRE_ADHAN_NOTIFICATION" />
                <action android:name="com.ybugmobile.waktiva.ACTION_SKIP_ADHAN" />
                <action android:name="com.ybugmobile.waktiva.ACTION_PRAYER_LOG_REMINDER" />
                <action android:name="com.ybugmobile.waktiva.ACTION_MARK_ALL_PRAYED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.AdhanStopReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ybugmobile.waktiva.ACTION_STOP_ADHAN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Widget receiver (plain AppWidgetProvider — no Glance) -->
        <receiver
            android:name=".ui.widget.WaktivaWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waktiva_widget_info" />
        </receiver>

        <!-- The small countdown widget, beside the main one; refreshed with it by WaktivaWidget.updateAll -->
        <receiver
            android:name=".ui.widget.WaktivaCountdownWidget"
            android:exported="true"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waktiva_countdown_widget_info" />
        </receiver>

        <!-- The day circle widgets: the 4×2 day ring and the 4×4 "my day"; refreshed with the others by WaktivaWidget.updateAll -->
        <receiver
            android:name=".ui.widget.WaktivaDayRingWidget"
            android:exported="true"
            android:label="@string/widget_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waktiva_day_ring_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.WaktivaMyDayWidget"
            android:exported="true"
            android:label="@string/widget_my_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waktiva_my_day_widget_info" />
        </receiver>

        <!-- Marks a prayer from a day circle widget's token, and runs those widgets' half-hourly tick -->
        <receiver
            android:name=".ui.widget.DayWidgetActionReceiver"
            android:exported="false" />

        <!-- WorkManager's internal service: must declare foregroundServiceType to match
             the type used in AdhanWorker's ForegroundInfo (FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaPlayback"
            tools:node="merge" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>