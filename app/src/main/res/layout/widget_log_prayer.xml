<?xml version="1.0" encoding="utf-8"?>
<!-- One of today's prayers in the prayer log widget: its mark over its name. The whole column, the row's full height, is its tap target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_log_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_weight="1"
    android:background="@drawable/widget_log_cell"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/widget_log_dot"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_log_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="#CCFFFFFF"
        android:textSize="10.5sp" />
</LinearLayout>
