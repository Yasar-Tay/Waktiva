<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): a still of the prayer log widget at level 5, three of today's prayers marked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_medal_preview"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:text="5"
                android:textColor="#FF2E2108"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:text="@string/prayer_log_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:progress="620"
                    android:progressDrawable="@drawable/widget_xp_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:text="🔥 4   🏅 3/8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:src="@drawable/widget_log_dot_preview" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:src="@drawable/widget_log_dot_preview" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:src="@drawable/widget_log_dot_preview" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:alpha="0.3"
                android:src="@drawable/widget_log_dot_preview" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:alpha="0.3"
                android:src="@drawable/widget_log_dot_preview" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
