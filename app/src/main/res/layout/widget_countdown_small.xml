<?xml version="1.0" encoding="utf-8"?>
<!--
  The countdown widget (2×1 and up): the time left to the next prayer, as large as the cell
  allows, on the sky of the hour lit by the prayer's own colour.
      [icon] DHUHR                13:07
      1:23:45
      ▬
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="#A6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Takes all the room left and grows to fill it, in light tabular figures. -->
        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="64sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:countDown="true"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp" />

        <!-- A short stroke in the prayer's colour. -->
        <ImageView
            android:id="@+id/widget_accent"
            android:layout_width="22dp"
            android:layout_height="3dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_accent_bar" />
    </LinearLayout>

    <!-- Shown until the app has cached a day of prayer times. -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_empty"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
