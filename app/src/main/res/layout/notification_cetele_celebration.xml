<?xml version="1.0" encoding="utf-8"?>
<!-- A prayer log cheer, expanded: on a sheet edged in gold, the medal beside what was won, what
     it asked for, and what else came with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/cetele_notification_panel_gold"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="16dp"
    android:paddingEnd="14dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/cetele_medal"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cetele_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hind_siliguri_bold"
            android:letterSpacing="0.2"
            android:textColor="#FFE6BE5A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cetele_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hind_siliguri_bold"
            android:maxLines="2"
            android:textColor="#FFF6DE9A"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/cetele_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:maxLines="2"
            android:textColor="#FFA39D8C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cetele_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/cetele_notification_chip"
            android:fontFamily="@font/inter_bold"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="#FFE6BE5A"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
