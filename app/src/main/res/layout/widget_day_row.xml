<?xml version="1.0" encoding="utf-8"?>
<!--
  One of the day's prayers in the "my day" widget, as a line: its mark (a tick once prayed, a
  cross once missed, a ring in its colour while its time is on, a dashed ring while to come),
  its name and its time. A tap marks it or takes the mark back once its time has come.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/widget_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/widget_row_mark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</LinearLayout>
