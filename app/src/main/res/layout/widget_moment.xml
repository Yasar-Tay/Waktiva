<?xml version="1.0" encoding="utf-8"?>
<!--
  The moment, shared by the day circle widgets: a chip naming the prayer whose time it is (or
  that it's prayed, or what's next), the live countdown with "left" beside it, and the prayer it
  counts to with the weather now at the end of the line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_label_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/widget_label_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_dot" />

        <ImageView
            android:id="@+id/widget_label_check"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_check"
            android:tint="#E6FFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#E6FFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:fontFamily="@font/inter_light"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/widget_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1"
            android:text="@string/widget_left"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_next_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <include layout="@layout/widget_weather_now" />
    </LinearLayout>
</LinearLayout>
