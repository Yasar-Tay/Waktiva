<?xml version="1.0" encoding="utf-8"?>
<!-- "I prayed": the day circle widgets' one action, a gold disc that marks the prayer whose time it is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mark"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:background="@drawable/widget_mark_button"
    android:gravity="center"
    android:orientation="vertical"
    android:visibility="gone">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_check"
        android:tint="#FF3B2A00" />

    <TextView
        android:id="@+id/widget_mark_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/prayer_log_mark"
        android:textColor="#FF3B2A00"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
