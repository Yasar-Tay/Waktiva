<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 "prayer now" widget. It shows only what matters at this moment (see DayWidgets): the
  prayer whose time it is and the time left for it, with "I prayed" beside it until it's marked;
  once it is, a calm countdown to the next prayer with the weather and today's five marks.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <include
            layout="@layout/widget_moment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- "I prayed", while the prayer whose time it is isn't marked. -->
        <include
            layout="@layout/widget_mark_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="10dp" />

        <!-- Once it's marked: the weather and today's five marks. -->
        <LinearLayout
            android:id="@+id/widget_calm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/widget_weather_now" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include layout="@layout/widget_marks" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_empty" />

</FrameLayout>
