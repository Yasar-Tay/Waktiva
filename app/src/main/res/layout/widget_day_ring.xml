<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 "prayer now" widget. It shows only what matters at this moment (see DayWidgets): the
  prayer whose time it is and the time left for it, the bar of its time from its start to the
  next prayer, and beside them the "I prayed" button, which becomes the day's tally once the
  prayer is marked.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- The label, and the weather now at the end of its line. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include layout="@layout/widget_moment_label" />

                <include layout="@layout/widget_weather_now" />
            </LinearLayout>

            <!-- The time left, centred in the height between the label and the bar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/widget_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:countDown="true"
                    android:fontFamily="@font/inter_light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:shadowColor="#40000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/widget_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="3dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:text="@string/widget_left"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- The prayer's time so far; the day's strip once it's prayed or while none is on. -->
            <ProgressBar
                android:id="@+id/widget_window"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                android:max="1000"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/widget_window_bar" />

            <include layout="@layout/widget_segments" />

            <!-- When the prayer's time began, and the prayer it runs to. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="#A6FFFFFF"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/widget_next_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- "I prayed" while the prayer waits; the day's tally once it's marked. -->
        <FrameLayout
            android:id="@+id/widget_mark"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp">

            <ImageView
                android:id="@+id/widget_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:maxHeight="120dp"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/widget_empty" />
</FrameLayout>
