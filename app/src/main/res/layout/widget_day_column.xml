<?xml version="1.0" encoding="utf-8"?>
<!--
  One of the day's prayers in the "my day" widget, as a card: its mark (a tick once prayed, an
  empty ring while it can still be marked), its name and its time. A tap marks it or takes the
  mark back once its time has come.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cell"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_weight="1"
    android:background="@drawable/widget_day_card"
    android:gravity="center_horizontal"
    android:minHeight="76dp"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/widget_cell_mark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/widget_cell_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#B3FFFFFF"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/widget_cell_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/inter_medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
</LinearLayout>
