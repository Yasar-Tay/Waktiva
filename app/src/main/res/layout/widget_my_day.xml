<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×4 "my day" widget: the date and the weather now on top, the moment as a card in the
  prayer's colour (its label, the time left, the bar of its time and the "I prayed" button), and
  the day's prayers as a line each, which mark their prayer with a tap once its time has come.
  The moment's views keep the 4×2's ids, so DayWidgets binds them alike.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- The date, Gregorian over Hijri, and the weather now. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:maxLines="1"
                    android:shadowColor="#40000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:textColor="#A6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:shadowColor="#40000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The moment, as a card in the prayer's colour. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/widget_hero_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_hero_card" />

            <LinearLayout
                android:id="@+id/widget_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include layout="@layout/widget_moment_label" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Chronometer
                            android:id="@+id/widget_chrono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:countDown="true"
                            android:fontFamily="@font/inter_light"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.03"
                            android:maxLines="1"
                            android:shadowColor="#40000000"
                            android:shadowDy="1"
                            android:shadowRadius="6"
                            android:textColor="#FFFFFFFF"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/widget_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:maxLines="1"
                            android:text="@string/widget_left"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/widget_window"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:indeterminate="false"
                        android:max="1000"
                        android:maxHeight="5dp"
                        android:minHeight="5dp"
                        android:progressDrawable="@drawable/widget_window_bar" />

                    <include layout="@layout/widget_segments" />
                </LinearLayout>

                <!-- "I prayed" while the prayer waits; the day's tally once it's marked. -->
                <FrameLayout
                    android:id="@+id/widget_mark"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp">

                    <ImageView
                        android:id="@+id/widget_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- The day's prayers, a line each, sharing the height left; added at runtime from widget_day_row. -->
        <LinearLayout
            android:id="@+id/widget_times"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <include layout="@layout/widget_empty" />
</FrameLayout>
