<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 prayer log widget, the çetele's night (see PrayerLogWidget): on the left the day's stars
  on the sun's path, the lit ones joined, with how many are lit, or Cassiopeia's W once the day is
  full; on the right the prayer whose time is on, the level, the streak, and "I prayed".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05">

            <ImageView
                android:id="@+id/widget_log_sky"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_log_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                android:textColor="#FFF4F1FF"
                android:textSize="38sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/widget_log_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.14"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="#FFC5CBF0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_log_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/cormorant_garamond_bold"
                android:maxLines="1"
                android:textColor="#FFF4F1FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_log_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:maxLines="2"
                android:textColor="#B3E4E2FF"
                android:textSize="11.5sp" />

            <!-- A spacer: widgets can't hold a plain View, so a FrameLayout. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/widget_log_mark"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/widget_sky_button"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_star" />

                <TextView
                    android:id="@+id/widget_log_mark_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:textColor="#FFF4F1FF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- With the prayer log off: where to turn it on. -->
    <TextView
        android:id="@+id/widget_log_off"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_prayer_log_off"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <include layout="@layout/widget_empty" />

</FrameLayout>
