<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS-style widget. Starts as a 2×2 square and resizes into the 4×2 and 4×4 families;
  WaktivaIosWidget picks the matching layout for every size the launcher reports.
  updatePeriodMillis stays 0: refreshes are driven by PrayerAlarmReceiver at prayer boundaries.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_ios_description"
    android:initialLayout="@layout/widget_ios_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_ios_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
