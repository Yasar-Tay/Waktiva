<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS-style 2×2 widget. It resizes only around the square; the wider sizes are their own
  widgets (countdown 4×1, prayer now 4×2, my day 4×4). Widgets still placed short from an
  earlier design get the countdown bar (see WaktivaWidget).
  updatePeriodMillis stays 0: refreshes are driven by PrayerAlarmReceiver at prayer boundaries.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_small"
    android:maxResizeHeight="200dp"
    android:maxResizeWidth="200dp"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
