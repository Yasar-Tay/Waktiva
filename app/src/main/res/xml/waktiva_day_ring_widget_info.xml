<?xml version="1.0" encoding="utf-8"?>
<!--
  The "prayer now" widget: a 4×2 with the prayer whose time it is, the time left for it and
  "I prayed". Below ~150 dp tall its countdown is smaller (see DayWidgets).
  Refreshed by WaktivaWidget.updateAll at prayer boundaries and by DayWidgets' half-hourly tick,
  so updatePeriodMillis stays 0.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_ring_description"
    android:initialLayout="@layout/widget_day_ring"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="100dp"
    android:previewLayout="@layout/widget_day_ring_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
