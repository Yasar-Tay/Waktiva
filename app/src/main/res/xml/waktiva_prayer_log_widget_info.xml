<?xml version="1.0" encoding="utf-8"?>
<!--
  The prayer log widget: a 4×2 with the level, XP, streak, badges and today's five prayers to
  mark (see PrayerLogWidget). Refreshed with the other widgets by WaktivaWidget.updateAll, so
  updatePeriodMillis stays 0.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_prayer_log_description"
    android:initialLayout="@layout/widget_prayer_log"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="220dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_prayer_log_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
