<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer log widget preview's medal: a gold coin in a faint ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="#FFFFD54F"
                android:endColor="#FFE0A800"
                android:startColor="#FFFFECB3" />
        </shape>
    </item>
</layer-list>
