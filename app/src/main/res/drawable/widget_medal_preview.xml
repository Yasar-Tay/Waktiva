<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer log widget preview's medal: a brass sphere in a dark groove. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="5dp" android:color="#47000000" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="#FFDEBE78"
                android:endColor="#FFA77C34"
                android:startColor="#FFF6E1A2" />
            <stroke android:width="0.7dp" android:color="#B3F6E1A2" />
        </shape>
    </item>
</layer-list>
