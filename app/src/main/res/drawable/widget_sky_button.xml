<?xml version="1.0" encoding="utf-8"?>
<!-- The widgets' "I prayed": a pill of lilac glass with a light edge, brighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#669FA8DA" />
            <stroke android:width="1dp" android:color="#B3D6DAFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D9FA8DA" />
            <stroke android:width="1dp" android:color="#8CD6DAFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
