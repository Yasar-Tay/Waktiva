<?xml version="1.0" encoding="utf-8"?>
<!-- A prayer gone unmarked, as the prayer log draws it: a dark hole ringed in coral. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="#E603050D" />
            <stroke android:width="1.2dp" android:color="#BFFFB4B4" />
        </shape>
    </item>
</layer-list>
