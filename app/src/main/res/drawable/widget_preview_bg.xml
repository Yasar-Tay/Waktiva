<?xml version="1.0" encoding="utf-8"?>
<!-- Static daylight gradient for the widget picker preview (the live widget draws its own). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF2773CE"
        android:endColor="#FF5AA6E8"
        android:type="linear" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
