<?xml version="1.0" encoding="utf-8"?>
<!-- A prayed prayer's card in the "my day" widget: tinted and edged in gold, brighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFD54F" />
            <stroke android:width="1dp" android:color="#B3FFD54F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFD54F" />
            <stroke android:width="1dp" android:color="#80FFD54F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
