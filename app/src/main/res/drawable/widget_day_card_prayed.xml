<?xml version="1.0" encoding="utf-8"?>
<!-- A prayed prayer's card in the "my day" widget: a brighter pane (its name and tick take the prayer's colour), brighter still while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
